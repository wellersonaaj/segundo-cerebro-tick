PORT=3000
NODE_ENV=development

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Senha do Postgres (Settings → Database → Database password) — só para npm run db:apply-migrations
# SUPABASE_DB_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

MCP_TRANSPORT=stdio

# Optional: run integration tests against real OpenAI
RUN_OPENAI_INTEGRATION_TESTS=false

# Memory compiler: off | shadow | enforce (enforce throws MEMORY_COMPILER_ENFORCE_NOT_IMPLEMENTED)
# MEMORY_COMPILER_MODE=shadow

# Extractor runtime (prod stays v1.3; v1.4 throws EXTRACTOR_V14_RUNTIME_NOT_ENABLED)
# EXTRACTOR_RUNTIME_VERSION=v1.3
# EXTRACTOR_V14_SHADOW_ENABLED=false

# Greenfield homolog (Bloco 6)
# GREENFIELD_SCHEMA=true
# EXTRACTOR_V14_SHADOW_ENABLED=true
# PERSIST_COMPILED_MEMORY_V2=true
# ALLOW_GREENFIELD_SCHEMA_APPLY=true
# GREENFIELD_SCHEMA_APPLY_CONFIRM=your-project.supabase.co
# SUPABASE_DB_PASSWORD=... npm run db:apply-greenfield-schema

# Live extractor v1.4 calibration (synthetic/anonymized only)
# ALLOW_EXTRACTOR_V14_LIVE_CALIBRATION=true
# npm run test:extractor:v1.4:live -- --categories=bootstrap_panorama --repetitions=10 --capture-live-fixtures

# Live extractor calibration (requires OPENAI_API_KEY; synthetic cases only)
# ALLOW_LIVE_EXTRACTOR_CALIBRATION=true
# npm run test:compiler:calibration -- --live-extractor --live-limit=8
# npm run test:compiler:calibration -- --capture-live-fixtures --categories=alias_reassignment,episodic_meeting --repetitions=10
# npm run promote:live-captures -- <arquivo.json>

# Bootstrap import (manual only — never enable in CI)
# ALLOW_BOOTSTRAP_IMPORT=true
# BOOTSTRAP_MAX_CHARS=50000

# Processamento interno + proteção REST em production
# Obrigatório em NODE_ENV=production para liberar dados (/audit/inbox-items*, /entities*, etc.)
# Header: x-internal-processing-secret
# INTERNAL_PROCESSING_SECRET=segredo_compartilhado_com_n8n

# Telegram (interface conversacional via webhook — n8n encaminha para POST /webhooks/telegram)
TELEGRAM_BOT_TOKEN=meutoken
TELEGRAM_ALLOWED_USER_ID=5991664193
TELEGRAM_WEBHOOK_SECRET=segredo_gerado
TELEGRAM_WEBHOOK_URL=https://sua-url-do-n8n/webhook/telegram-cerebro-tick
# TELEGRAM_DEFAULT_TIMEZONE=America/Sao_Paulo
# npm run telegram:set-webhook
