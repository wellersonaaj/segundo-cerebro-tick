{
  "name": "segundo-cerebro-tick",
  "version": "0.1.0",
  "private": true,
  "description": "Segundo Cérebro Pessoal com Agentes de IA — MVP API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:smoke": "tsx scripts/e2e-smoke-test.ts",
    "test:mcp:smoke": "tsx scripts/mcp-smoke-test.ts",
    "test:clarification:smoke": "tsx scripts/clarification-smoke-test.ts",
    "test:correction:smoke": "tsx scripts/correction-smoke-test.ts",
    "verify:env": "tsx scripts/verify-env.ts",
    "reset:test-data": "tsx scripts/reset-test-data.ts",
    "import:bootstrap": "tsx scripts/import-bootstrap-memory.ts",
    "mcp": "tsx src/mcp/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@modelcontextprotocol/sdk": "1.12.1",
    "@supabase/supabase-js": "2.49.1",
    "fastify": "5.2.1",
    "openai": "4.96.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@typescript-eslint/eslint-plugin": "8.26.1",
    "@typescript-eslint/parser": "8.26.1",
    "eslint": "9.22.0",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.9"
  }
}
