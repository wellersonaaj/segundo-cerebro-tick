{
  "name": "segundo-cerebro-tick",
  "version": "0.1.0",
  "private": true,
  "description": "Segundo Cérebro Pessoal com Agentes de IA — MVP API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "verify:runtime": "tsx scripts/verify-runtime-assets.ts",
    "start:prod": "node dist/server.js",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:smoke": "tsx scripts/e2e-smoke-test.ts",
    "test:mcp:smoke": "tsx scripts/mcp-smoke-test.ts",
    "test:clarification:smoke": "tsx scripts/clarification-smoke-test.ts",
    "test:correction:smoke": "tsx scripts/correction-smoke-test.ts",
    "verify:env": "tsx scripts/verify-env.ts",
    "db:apply-migrations": "tsx scripts/apply-pending-migrations.ts",
    "db:apply-greenfield-schema": "tsx scripts/apply-greenfield-schema.ts",
    "db:apply-incremental-migrations": "tsx scripts/apply-incremental-migrations.ts",
    "db:investigate-bug1": "tsx scripts/investigate-bug1-entity-aliases.ts",
    "reset:test-data": "tsx scripts/reset-test-data.ts",
    "import:bootstrap": "tsx scripts/import-bootstrap-memory.ts",
    "test:bootstrap:smoke": "tsx scripts/bootstrap-smoke-test.ts",
    "bootstrap:controlled": "tsx scripts/run-controlled-bootstrap.ts",
    "test:external-action:classification": "tsx scripts/run-external-action-classification.ts",
    "test:pipeline:smoke": "tsx scripts/pipeline-smoke-test.ts",
    "test:homolog:memory-reference": "tsx scripts/homolog-memory-reference-smoke.ts",
    "test:compiler:calibration": "tsx scripts/run-memory-compiler-calibration.ts",
    "promote:live-captures": "tsx scripts/promote-live-captures.ts",
    "audit:live-variability": "tsx scripts/audit-live-variability-detail.ts",
    "extractor:v1.4:isolated": "tsx scripts/run-extractor-v1.4-isolated.ts",
    "test:extractor:v1.4:fixed": "tsx scripts/run-extractor-v1.4-fixed-calibration.ts",
    "test:extractor:v1.4:context": "tsx scripts/run-extractor-v1.4-context-calibration.ts",
    "test:extractor:v1.4:live": "tsx scripts/run-extractor-v1.4-live-calibration.ts",
    "calibrate:temporal:normalizer": "tsx scripts/run-temporal-normalizer-calibration.ts",
    "audit:extractor:v1.4:live": "tsx scripts/audit-extractor-v1.4-live-detail.ts",
    "mcp": "tsx src/mcp/server.ts",
    "telegram:set-webhook": "tsx scripts/telegram-set-webhook.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@modelcontextprotocol/sdk": "1.12.1",
    "@supabase/supabase-js": "2.49.1",
    "fastify": "5.2.1",
    "openai": "4.96.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "8.26.1",
    "@typescript-eslint/parser": "8.26.1",
    "eslint": "9.22.0",
    "pg": "^8.21.0",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.9"
  }
}
